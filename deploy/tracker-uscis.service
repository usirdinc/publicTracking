[Unit]
Description=Tracker USCIS case status worker (official API, no browser)
After=network.target

[Service]
User=tracker
WorkingDirectory=/home/tracker/publicTracking
ExecStart=/home/tracker/publicTracking/.venv/bin/python -m worker.uscis_run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
