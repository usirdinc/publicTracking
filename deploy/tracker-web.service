[Unit]
Description=AAF Tracker web app
After=network.target

[Service]
User=tracker
WorkingDirectory=/home/tracker/publicTracking
ExecStart=/home/tracker/publicTracking/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always

[Install]
WantedBy=multi-user.target
