# Copy to .env on the VPS (chmod 600). Never commit the real file.
BASE_URL=https://track.usird.org
SECRET_KEY=            # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DATA_KEY=              # python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  (back this up: losing it loses all case numbers)
ADMIN_EMAILS=you@usird.org
BETA_CAP=200

SQUARE_ENV=production
SQUARE_CHECKOUT_URL=           # Square payment link for the $5/month subscription plan
SQUARE_ACCESS_TOKEN=           # Square Developer > your app > Production access token
SQUARE_WEBHOOK_SIGNATURE_KEY=  # from the webhook subscription for BASE_URL/webhooks/square

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AAF Tracker <alerts@usird.org>

# USCIS Case Status API: copy from USIRD v2 admin > USCIS settings (never paste into chat)
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_DEMO_ID=
USCIS_TOKEN_URL=https://api.uscis.gov/oauth/accesstoken
USCIS_API_BASE_URL=https://api.uscis.gov/case-status/
USCIS_RECHECK_HOURS=24
